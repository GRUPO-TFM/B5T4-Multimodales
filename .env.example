# Copia este fichero como .env (en la raíz del repo) y rellénalo. .env NO se sube a Git.

# Carpeta de la empresa sobre la que trabajan los agentes (la copia estructurada).
B5T4_DATA_DIR=C:/Users/javie/OneDrive/04. Andbank Work/Tarea MIAX

# LLM y visión (https://openrouter.ai/keys). Sin clave, los agentes que redactan no se ejecutan.
OPENROUTER_API_KEY=

# Verificador Jev (TypeSafe). Opcional: sin clave, no hay verificación ni puerta de cumplimiento.
JEV_API_KEY=

# Opcional: cambiar de modelo sin tocar config/b5t4.toml
# B5T4_MODEL_MAIN=google/gemini-3.8-flash
# B5T4_MODEL_CHEAP=deepseek/deepseek-v4.1-flash
# B5T4_MODEL_VISION=google/gemini-3.8-flash
