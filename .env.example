# Copia este fichero como .env (en la raíz del repo) y rellénalo. .env NO se sube a Git.

# Carpeta de la empresa sobre la que trabajan los agentes (la copia estructurada).
B5T4_DATA_DIR=C:/Users/javie/OneDrive/04. Andbank Work/Tarea MIAX

# Opcional: reutilizar modelos de voz locales desde otro checkout/worktree.
# B5T4_MODELS_DIR=C:/ruta/al/repositorio/models

# LLM y visión (https://openrouter.ai/keys). Sin clave, los agentes que redactan no se ejecutan.
OPENROUTER_API_KEY=

# Jev (TypeSafe). Necesario para v2; solo v1 --report-only admite borrador sin verificar.
JEV_API_KEY=

# Opcional: enlace público de la interfaz con «uv run b5t4 ui --ngrok».
# Authtoken personal: https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=
# Dominio reservado; vacío = el dominio fijo que ngrok asigna a la cuenta.
# NGROK_DOMAIN=
# Usuario y clave que pide la interfaz. Recomendado siempre que se comparta un enlace público.
# B5T4_UI_AUTH=usuario:clave

# Opcional: cambiar de modelo sin tocar config/b5t4.toml
# B5T4_MODEL_MAIN=google/gemini-3.8-flash
# B5T4_MODEL_CHEAP=deepseek/deepseek-v4.1-flash
# B5T4_MODEL_VISION=google/gemini-3.8-flash
# B5T4_MODEL_IMAGE=google/gemini-3.1-flash-image
# B5T4_MODEL_TTS=google/gemini-3.8-flash-tts
